# Every value here is optional; the widget runs with no .env at all.

# Host port. 8091 is the reddit widget, 90 is Glance itself.
WIDGET_PORT=8092

# Debug ships monthly and backfills feed contents weeks later, so twice a day
# is already more often than the data changes.
REFRESH_HOURS=12

# Steam cover art. Set to 0 to run on magazine covers alone.
STEAM_ENABLED=1
# Seconds between Steam search calls during a backfill.
STEAM_DELAY=1.2
